{
  "name": "widgetctl",
  "version": "0.1.0",
  "description": "Programmatic iOS Simulator widget setup for tests",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DimaMishchenko/widgetctl.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "widgetctl": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "import": "./dist/playwright.js"
    }
  },
  "files": [
    "dist",
    "native/worker.m",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "npm run build",
    "test:live": "node --import tsx test/live.ts",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "test:playwright": "npm run build && node --import tsx --test test/playwright.test.ts"
  },
  "dependencies": {
    "bplist-parser": "^0.3.2",
    "plist": "^3.1.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0 <2"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.19.0",
    "@types/plist": "^3.0.5",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
